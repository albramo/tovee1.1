{%- comment -%}
  Renders store policies as a collapsible menu block on the footer section

  Accepts:
  - block: {Object}

  Usage:
  {% render 'footer-policies', block: block %}
{%- endcomment -%}

{%- liquid
  assign policies_count = 0
  for policy in shop.policies
    unless policy == blank
      assign policies_count = policies_count | plus: 1
    endunless
  endfor
-%}

{%- if policies_count > 0 -%}
  {%- capture block_content -%}
    <div class="details__content">
      <ul class="flex flex-col gap-3">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <li class="inline-flex">
              <a href="{{ policy.url }}" class="block reversed-link text-sm-lg leading-tight">{{ policy.title }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <style>
      @media (min-width: 1280px) {
        .footer__item--{{ block.id }} { width: calc({{ block.settings.container_width }}% - var(--sp-12)); }
      }
    </style>
  {%- endcapture -%}

  {%- if block.settings.heading == blank -%}
    <div class="footer__item--{{ block.id }} no-details" {{ block.shopify_attributes }}>
      {{- block_content -}}
    </div>
  {%- else -%}
    <details class="footer__item--{{ block.id }} details active" is="footer-details"{% if block.settings.opened %} data-opened{% endif %} {{ block.shopify_attributes }}>
      <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
        <span class="heading text-base-2xl font-medium lg:font-heading">{{ block.settings.heading | escape }}</span>
        {%- render 'icon', icon: 'chevron-up' -%}
      </summary>
      {{- block_content -}}
    </details>
  {%- endif -%}
{%- endif -%}
